rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /system_config/{configId} {
      allow read, write: if true;
    }

    match /user_tokens/{tokenId} {
      allow read, write: if true;
    }

    match /oauth_states/{stateId} {
      allow read, write: if true;
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
